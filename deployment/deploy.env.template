# Settings for `make deploy`. Copy to deploy.env (git-ignored) and fill in.
# Everything goes through the k3s API as the heal-deployer service account:
# manifests with its token, images to the registry inside k3s through a
# port-forward on the same API. README § Kubernetes (k3s) has the setup.

# The API as this machine reaches it (VPN / office network, never the
# internet). The name must be in the k3s certificate -- README shows how.
DEPLOY_API_SERVER=https://<node name>:6443
# heal-deployer's token. Leave empty and keep it in the macOS Keychain:
#   security add-generic-password -U -a heal-deployer -s heal-deploy-token -w
DEPLOY_KUBE_TOKEN=
# The cluster's CA certificate (not secret). TLS is always verified.
DEPLOY_KUBE_CA=~/.config/heal-deploy/ca.crt
DEPLOY_NAMESPACE=heal

# Only commits already on this branch on GitHub can be deployed.
DEPLOY_GIT_REMOTE=origin
DEPLOY_BRANCH=main

# The node's architecture -- NOT your laptop's. Apple Silicon builds arm64 by
# default; every build is checked against this.
DEPLOY_PLATFORM=linux/amd64

# Backend PyTorch build: cpu (no GPU libraries, ~2.5 GB smaller) or cuda for a
# GPU node. The build fails if the installed torch does not match.
DEPLOY_TORCH_VARIANT=cpu

# Scan severities that block a deploy.
DEPLOY_FAIL_SEVERITY=CRITICAL,HIGH

# Optional image signing with cosign (`cosign generate-key-pair`). Keep the
# private key off the server; every signature is verified before deploying.
DEPLOY_COSIGN_KEY=
DEPLOY_COSIGN_PUBKEY=
