# Fill in the values and copy this file to `.env` in the deployment directory.
# Used by docker-compose.prod.yml. Nginx has its own file, .env.nginx --
# see env.nginx.template.


# Public URL of the deployment, e.g. https://heal.example.org
WEB_DOMAIN=http://localhost:3000


# --- Translation -----------------------------------------------------------
# Design A: Luganda in -> English through the system -> Luganda out. Both URLs
# are required for Luganda support; English-only deployments can leave them
# blank and Luganda chat will fail with a config error naming the variable.
# No default is baked into the image on purpose.
TRANSLATION_PROVIDER=heal_mt
# Base URL of the Luganda->English service, no trailing slash
TRANSLATION_EN_URL=
# Base URL of the English->Luganda service, no trailing slash
TRANSLATION_LUG_URL=
# Optional bearer token sent to both services
#TRANSLATION_API_KEY=
#TRANSLATION_CONNECT_TIMEOUT=5
#TRANSLATION_READ_TIMEOUT=60
#TRANSLATION_MAX_RETRIES=2


# --- Chat model ------------------------------------------------------------
# Ids come from the catalogue in backend/heal/llm/registry.py.
GEN_AI_MODEL_PROVIDER=openai
GEN_AI_API_KEY=
#HEAL_CHAT_MODEL=gpt-4o-mini
# Cheaper model used for intent classification and other short internal calls
#HEAL_CLASSIFIER_MODEL=gpt-4o-mini
# Comma-separated allowlist offered to users; empty means the whole catalogue
#HEAL_ENABLED_CHAT_MODELS=
#HEAL_LLM_TIMEOUT=60
# Set to use Azure OpenAI or a compatible endpoint
#GEN_AI_API_ENDPOINT=
#GEN_AI_API_VERSION=


# --- Safety ----------------------------------------------------------------
# Shown ahead of any answer classified EMERGENCY. Set this to the number that
# is actually correct for the deployment's country before the pilot.
HEAL_EMERGENCY_CONTACT=912


# --- Knowledge / retrieval (Phase 2) ---------------------------------------
# Phase 1 ships with retrieval off. Leave KNOWLEDGE_ENABLED=false until the
# Qdrant collection exists and the clinician eval set has been run --
# `false` reproduces Phase 1 behaviour exactly.
#
# When turning this on, start the stack with `--profile knowledge` and set both
# values below. Qdrant runs unauthenticated by default, so the API key is
# required, not optional.
KNOWLEDGE_ENABLED=false
#QDRANT_URL=http://qdrant:6333
#QDRANT_API_KEY=
#QDRANT_COLLECTION=heal_reference_384


# --- Nginx -----------------------------------------------------------------
# `app.conf.template` for the certbot flow (run with --profile letsencrypt),
# `app.conf.template.no-letsencrypt` when TLS is terminated upstream.
NGINX_CONF_TEMPLATE=app.conf.template


# --- Authentication --------------------------------------------------------
# Supported flows: disabled | basic | google_oauth
AUTH_TYPE=google_oauth

# Set these to use Google OAuth
# https://developers.google.com/identity/gsi/web/guides/get-google-api-clientid
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SECRET=

# If using basic auth and you want to require email verification, uncomment:
#REQUIRE_EMAIL_VERIFICATION=true
#SMTP_USER=your-email@company.com
#SMTP_PASS=your-app-password

# Only needed if you aren't using gmail as your SMTP
#SMTP_SERVER=
#SMTP_PORT=
# Used when SMTP_USER is missing
#EMAIL_FROM=

# How long before a user must reauthenticate (cookie expiry). Default 1 day.
SESSION_EXPIRE_TIME_SECONDS=86400

# Restrict sign-in to specific domains, only checked when auth is on
# e.g. VALID_EMAIL_DOMAINS=example.com,example.org
#VALID_EMAIL_DOMAINS=


# --- Database --------------------------------------------------------------
# The database is not published to the host; it is reachable only on the
# compose network.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=


# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
DISABLE_TELEMETRY=true
# Logs every prompt sent to the model. Never enable against real users.
#LOG_ALL_MODEL_INTERACTIONS=
