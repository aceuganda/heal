# Self-hosted model -- copy into your .env and fill in.
#
# An OpenAI-compatible endpoint (vLLM) on our own network. Setting the URL adds
# it to the catalogue as the model id `self-hosted`; leaving it empty changes
# nothing, so this file is safe to skip entirely.
#
# The address is internal and must not appear in source or in a browser. Only
# the API server talks to it.

# Base URL, including /v1.
HEAL_SELF_HOSTED_URL=http://your-internal-host:8000/v1

# Must match an id from GET $HEAL_SELF_HOSTED_URL/models exactly, or every
# call 404s.
HEAL_SELF_HOSTED_MODEL=ibnzterrell/Meta-Llama-3.3-70B-Instruct-AWQ-INT4

# Prompt + reply budget. `max_model_len` from that same response.
HEAL_SELF_HOSTED_CONTEXT_TOKENS=131072

# vLLM does not check this, but the client requires a non-empty string.
HEAL_SELF_HOSTED_API_KEY=not-needed

# Make it the default for chat. Without this the endpoint is configured and
# selectable but nothing routes to it.
HEAL_CHAT_MODEL=self-hosted

# The fallback when the internal endpoint cannot be reached, which is a cloud
# model and therefore needs a real key. Without one, an unreachable internal
# box means no answer at all.
GEN_AI_API_KEY=sk-...
