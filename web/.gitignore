# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Service worker output from the retired next-pwa plugin. Nothing generates
# these any more, but the rules stay so a re-enabled PWA build does not commit
# its artifacts by accident.
sw.*
workbox-*
swe-worker-*

# ...except the hand-written unregister worker, which IS source. See docs/pwa.md.
!public/sw.js